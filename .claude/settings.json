{
  "enabledMcpjsonServers": [
    "repoctx",
    "switchboard"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gal/Documents/Projects/repoctx/.venv/bin/python3 -m repoctx update --from-claude-hook"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gal/Documents/Projects/repoctx/.venv/bin/python3 -m repoctx hook tool-use"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gal/Documents/Projects/repoctx/.venv/bin/python3 -m repoctx hook prompt-nudge"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gal/Documents/Projects/repoctx/.venv/bin/python3 -m repoctx hook stop-check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.switchboard/hooks/stop.sh\" || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.switchboard/hooks/session-start.sh\" || true"
          }
        ]
      }
    ]
  }
}
